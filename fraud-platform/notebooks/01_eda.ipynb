{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Exploratory Data Analysis - PaySim Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "pd.set_option('display.max_columns', None)\n",
    "sns.set_style('whitegrid')\n",
    "\n",
    "DATA_FILE = Path('../data/paysim_sampled.csv')\n",
    "REPORTS_DIR = Path('../reports/eda')\n",
    "REPORTS_DIR.mkdir(parents=True, exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "df = pd.read_csv(DATA_FILE)\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic info\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)\n",
    "print(\"\\nMissing values:\")\n",
    "print(df.isnull().sum())\n",
    "print(\"\\nBasic statistics:\")\n",
    "print(df.describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class imbalance\n",
    "fraud_count = df['isFraud'].value_counts()\n",
    "fraud_rate = df['isFraud'].mean()\n",
    "print(f\"Fraud cases: {fraud_count[1]} ({fraud_rate:.4%})\")\n",
    "print(f\"Legitimate cases: {fraud_count[0]} ({1-fraud_rate:.4%})\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "fraud_count.plot(kind='bar', ax=ax, color=['steelblue', 'coral'])\n",
    "ax.set_title('Class Distribution')\n",
    "ax.set_xlabel('isFraud')\n",
    "ax.set_ylabel('Count')\n",
    "ax.set_yscale('log')\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS_DIR / 'class_distribution.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Transaction type distribution\n",
    "type_counts = df['type'].value_counts()\n",
    "print(\"\\nTransaction types:\")\n",
    "print(type_counts)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "type_counts.plot(kind='bar', ax=ax, color='steelblue')\n",
    "ax.set_title('Transaction Type Distribution')\n",
    "ax.set_xlabel('Transaction Type')\n",
    "ax.set_ylabel('Count')\n",
    "ax.set_yscale('log')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS_DIR / 'transaction_types.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fraud by transaction type\n",
    "fraud_by_type = df.groupby('type')['isFraud'].agg(['count', 'sum', 'mean'])\n",
    "fraud_by_type.columns = ['total', 'fraud_count', 'fraud_rate']\n",
    "print(\"\\nFraud by transaction type:\")\n",
    "print(fraud_by_type)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "fraud_by_type['fraud_rate'].plot(kind='bar', ax=ax, color='coral')\n",
    "ax.set_title('Fraud Rate by Transaction Type')\n",
    "ax.set_xlabel('Transaction Type')\n",
    "ax.set_ylabel('Fraud Rate')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS_DIR / 'fraud_by_type.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fraud rate over time (step)\n",
    "fraud_by_step = df.groupby('step')['isFraud'].agg(['count', 'sum', 'mean'])\n",
    "fraud_by_step.columns = ['total', 'fraud_count', 'fraud_rate']\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8))\n",
    "\n",
    "ax1.plot(fraud_by_step.index, fraud_by_step['total'], color='steelblue')\n",
    "ax1.set_title('Transaction Volume Over Time')\n",
    "ax1.set_xlabel('Step (hour)')\n",
    "ax1.set_ylabel('Transaction Count')\n",
    "\n",
    "ax2.plot(fraud_by_step.index, fraud_by_step['fraud_rate'], color='coral')\n",
    "ax2.set_title('Fraud Rate Over Time')\n",
    "ax2.set_xlabel('Step (hour)')\n",
    "ax2.set_ylabel('Fraud Rate')\n",
    "ax2.axhline(y=fraud_by_step['fraud_rate'].mean(), color='red', linestyle='--', label='Mean')\n",
    "ax2.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS_DIR / 'fraud_over_time.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Amount distribution by fraud status\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "df[df['isFraud'] == 0]['amount'].plot(kind='hist', bins=50, ax=ax1, color='steelblue', alpha=0.7)\n",
    "ax1.set_title('Amount Distribution - Legitimate')\n",
    "ax1.set_xlabel('Amount')\n",
    "ax1.set_ylabel('Count')\n",
    "ax1.set_yscale('log')\n",
    "\n",
    "df[df['isFraud'] == 1]['amount'].plot(kind='hist', bins=50, ax=ax2, color='coral', alpha=0.7)\n",
    "ax2.set_title('Amount Distribution - Fraud')\n",
    "ax2.set_xlabel('Amount')\n",
    "ax2.set_ylabel('Count')\n",
    "ax2.set_yscale('log')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS_DIR / 'amount_distribution.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Balance delta analysis (PaySim-specific pattern)\n",
    "df['balance_delta_org'] = df['oldbalanceOrg'] - df['newbalanceOrg'] - df['amount']\n",
    "df['balance_delta_dest'] = df['newbalanceDest'] - df['oldbalanceDest'] - df['amount']\n",
    "\n",
    "print(\"Balance delta mismatch in origin (should be 0):\")\n",
    "print(df['balance_delta_org'].describe())\n",
    "print(\"\\nBalance delta mismatch in destination (should be 0):\")\n",
    "print(df['balance_delta_dest'].describe())\n",
    "\n",
    "# Check if mismatches correlate with fraud\n",
    "org_mismatch = (df['balance_delta_org'].abs() > 0.01).astype(int)\n",
    "dest_mismatch = (df['balance_delta_dest'].abs() > 0.01).astype(int)\n",
    "\n",
    "print(\"\\nFraud rate when origin balance mismatches:\", df[org_mismatch == 1]['isFraud'].mean())\n",
    "print(\"Fraud rate when origin balance matches:\", df[org_mismatch == 0]['isFraud'].mean())\n",
    "print(\"\\nFraud rate when dest balance mismatches:\", df[dest_mismatch == 1]['isFraud'].mean())\n",
    "print(\"Fraud rate when dest balance matches:\", df[dest_mismatch == 0]['isFraud'].mean())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save summary statistics\n",
    "summary = {\n",
    "    'total_rows': len(df),\n",
    "    'fraud_count': int(df['isFraud'].sum()),\n",
    "    'fraud_rate': float(df['isFraud'].mean()),\n",
    "    'transaction_types': df['type'].nunique(),\n",
    "    'unique_orig_accounts': df['nameOrig'].nunique(),\n",
    "    'unique_dest_accounts': df['nameDest'].nunique(),\n",
    "    'time_steps': df['step'].nunique(),\n",
    "    'fraud_types': df[df['isFraud'] == 1]['type'].unique().tolist(),\n",
    "}\n",
    "\n",
    "import json\n",
    "with open(REPORTS_DIR / 'summary.json', 'w') as f:\n",
    "    json.dump(summary, f, indent=2)\n",
    "\n",
    "print(\"\\nEDA Summary:\")\n",
    "print(json.dumps(summary, indent=2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Key Findings\n",
    "\n",
    "1. **Class Imbalance**: Fraud cases are under 1% of all transactions (~{:.2%}). This requires special handling (scale_pos_weight, SMOTE, PR-AUC metric).\n",
    "\n",
    "2. **Transaction Types**: Only TRANSFER and CASH_OUT contain fraud. This is a critical filter for feature engineering.\n",
    "\n",
    "3. **Temporal Patterns**: Fraud rate varies over time steps. Time-based splitting is essential to avoid leakage.\n",
    "\n",
    "4. **Balance Delta**: PaySim has a known pattern where balance changes don't always match transaction amounts. This can be a strong fraud signal.".format(fraud_rate)"
   ]
  }
 ],
